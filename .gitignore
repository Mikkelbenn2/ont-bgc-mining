# Never commit data or results to git: they are large and may not be yours to share.
results/
*.fastq
*.fastq.gz
*.fq.gz
*.fasta
*.fna
*.bam
*.bai
*.pod5

# Your own project configs/sample sheets (paths are server-specific).
# Commit them deliberately if you want them versioned: git add -f config/my_project.sh
config/*.sh
!config/config.example.sh
config/*.tsv
!config/samples.example.tsv

# Local environments, databases, OS clutter
.envs/
databases/
.DS_Store
__pycache__/
*.pyc
